#!/usr/bin/env bash

set -euo pipefail

AGENT_DIR_VALUE=""
PROJECT_DIR_VALUE=""
NOTES_DIR_VALUE=""
MODE="task"
ACCESS="write"
PROMPT=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --agent-dir) AGENT_DIR_VALUE="${2:-}"; shift 2 ;;
    --project-dir) PROJECT_DIR_VALUE="${2:-}"; shift 2 ;;
    --notes-dir) NOTES_DIR_VALUE="${2:-}"; shift 2 ;;
    --mode) MODE="${2:-}"; shift 2 ;;
    --access) ACCESS="${2:-}"; shift 2 ;;
    --prompt) PROMPT="${2:-}"; shift 2 ;;
    *) echo "codex-oss: unknown argument: $1" >&2; exit 2 ;;
  esac
done

PROVIDER="${LOCAL_MODEL_PROVIDER:-}"
MODEL="${LOCAL_MODEL:-}"
CODEX_COMMAND="${LOCAL_CODEX_BIN:-codex}"
WORKER_MODE="${SDLC_WORKER:-0}"
declare -a EXECUTION_FLAGS=(--sandbox workspace-write --ephemeral)
declare -a SCOPE_FLAGS=()

[[ -d "$AGENT_DIR_VALUE" ]] || { echo "codex-oss: valid --agent-dir is required" >&2; exit 2; }
[[ -d "$PROJECT_DIR_VALUE" ]] || { echo "codex-oss: valid --project-dir is required" >&2; exit 2; }
if [[ -n "$NOTES_DIR_VALUE" ]]; then
  [[ -d "$NOTES_DIR_VALUE" ]] || { echo "codex-oss: --notes-dir must exist" >&2; exit 2; }
  SCOPE_FLAGS+=(--add-dir "$NOTES_DIR_VALUE")
fi
case "$ACCESS" in
  write|scoped-write|read-only) ;;
  *) echo 'codex-oss: --access must be write, scoped-write or read-only' >&2; exit 2 ;;
esac
case "$PROVIDER" in
  ollama|lmstudio) ;;
  *) echo "codex-oss: LOCAL_MODEL_PROVIDER must be ollama or lmstudio" >&2; exit 2 ;;
esac
[[ -n "$MODEL" && "$MODEL" != *$'\n'* && "$MODEL" != *$'\r'* ]] || {
  echo "codex-oss: exact LOCAL_MODEL is required" >&2
  exit 2
}
command -v "$CODEX_COMMAND" >/dev/null 2>&1 || {
  echo "codex-oss: command '$CODEX_COMMAND' was not found" >&2
  exit 127
}
if [[ "$WORKER_MODE" == "1" || "$ACCESS" == read-only ]]; then
  [[ "$MODE" == "task" ]] || {
    echo "codex-oss: read-only worker supports task mode only" >&2
    exit 2
  }
  EXECUTION_FLAGS=(--sandbox read-only --ephemeral)
fi

case "$MODE" in
  task)
    AGENT_DIR="$AGENT_DIR_VALUE" "$CODEX_COMMAND" exec --ignore-user-config \
      --oss --local-provider "$PROVIDER" -m "$MODEL" \
      "${EXECUTION_FLAGS[@]}" --cd "$PROJECT_DIR_VALUE" "${SCOPE_FLAGS[@]}" "$PROMPT"
    ;;
  session-start|interactive)
    echo 'codex-oss: BLOCKED: interactive Codex cannot disable ambient user configuration; use a registered command in task mode' >&2
    exit 2
    ;;
  *)
    echo "codex-oss: unsupported mode: $MODE" >&2
    exit 2
    ;;
esac
